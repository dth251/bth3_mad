<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:padding="18dp" android:background="@drawable/bg_card">
    <ImageView android:id="@+id/imgAvatar" android:layout_width="104dp" android:layout_height="104dp"
        android:layout_gravity="center_horizontal" android:src="@drawable/ic_people"
        android:scaleType="centerCrop" android:contentDescription="@string/avatar" />
    <Button android:id="@+id/btnChoosePhoto" style="@style/SecondaryButton" android:text="@string/choose_photo" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="@string/photo_note" android:textSize="12sp" android:textColor="@color/text_secondary" android:gravity="center" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
        android:text="@string/required_note" android:textSize="13sp" android:textColor="@color/text_secondary" />
    <TextView style="@style/FieldLabel" android:text="@string/employee_id" />
    <EditText android:id="@+id/edtEmployeeId" style="@style/FormInput" android:hint="@string/employee_id_hint"
        android:inputType="textCapCharacters|textNoSuggestions" android:maxLength="50" android:autofillHints="" />
    <TextView android:id="@+id/tvIdLocked" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="@string/id_locked" android:textSize="12sp"
        android:textColor="@color/text_secondary" android:visibility="gone" />
    <TextView style="@style/FieldLabel" android:text="@string/full_name" />
    <EditText android:id="@+id/edtFullName" style="@style/FormInput" android:hint="@string/full_name_hint"
        android:inputType="textPersonName|textCapWords" android:maxLength="150" android:autofillHints="name" />
    <TextView style="@style/FieldLabel" android:text="@string/birth_year" />
    <EditText android:id="@+id/edtBirthYear" style="@style/FormInput" android:hint="@string/birth_year_hint"
        android:inputType="number" android:maxLength="4" android:autofillHints="" />
    <TextView style="@style/FieldLabel" android:text="@string/gender" />
    <RadioGroup android:id="@+id/radioGender" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:checkedButton="@id/radioMale">
        <RadioButton android:id="@+id/radioMale" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/male" />
        <RadioButton android:id="@+id/radioFemale" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/female" />
        <RadioButton android:id="@+id/radioOther" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/other" />
    </RadioGroup>
    <TextView style="@style/FieldLabel" android:text="@string/hometown" />
    <EditText android:id="@+id/edtHometown" style="@style/FormInput" android:hint="@string/hometown_hint"
        android:inputType="textCapWords" android:maxLength="150" android:autofillHints="" />
    <TextView style="@style/FieldLabel" android:text="@string/education" />
    <EditText android:id="@+id/edtEducation" style="@style/FormInput" android:hint="@string/education_hint"
        android:inputType="textCapSentences" android:maxLength="100" android:autofillHints="" />
    <TextView style="@style/FieldLabel" android:text="@string/salary" />
    <EditText android:id="@+id/edtSalary" style="@style/FormInput" android:hint="@string/salary_hint"
        android:inputType="numberDecimal" android:imeOptions="actionDone" android:maxLength="18" android:autofillHints="" />
    <TextView style="@style/FieldLabel" android:text="@string/department" android:labelFor="@id/spinnerDepartment" />
    <Spinner android:id="@+id/spinnerDepartment" android:layout_width="match_parent" android:layout_height="52dp"
        android:background="@drawable/bg_input" android:spinnerMode="dropdown" android:contentDescription="@string/department" />
</LinearLayout>
