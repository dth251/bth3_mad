<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp" android:background="@color/primary">
        <TextView style="@style/ScreenTitle" android:text="@string/main_title" />
        <TextView style="@style/ScreenSubtitle" android:text="@string/main_subtitle" />
        <include layout="@layout/include_student" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="16dp">
        <EditText android:id="@+id/edtSearch" style="@style/FormInput"
            android:hint="@string/search_hint" android:inputType="text" android:imeOptions="actionDone"
            android:autofillHints="" android:maxLength="200" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/sort_label" android:textColor="@color/text_secondary" android:textSize="14sp" />
            <Spinner android:id="@+id/spinnerSort" android:layout_width="190dp" android:layout_height="48dp"
                android:spinnerMode="dropdown" android:contentDescription="@string/sort_label" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="12dp" android:paddingBottom="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/list_label" android:textColor="@color/text_secondary" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvCount" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/primary_dark" android:textSize="12sp" android:background="@drawable/bg_badge" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:paddingStart="16dp" android:paddingEnd="16dp">
        <ListView android:id="@+id/listNhanSu" android:layout_width="match_parent" android:layout_height="match_parent"
            android:divider="@android:color/transparent" android:dividerHeight="10dp" android:clipToPadding="false"
            android:paddingTop="4dp" android:paddingBottom="8dp" />
        <TextView android:id="@+id/tvEmpty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="center" android:gravity="center" android:padding="16dp" android:visibility="gone"
            android:drawableTop="@drawable/ic_people" android:drawablePadding="16dp"
            android:text="@string/empty_list" android:textColor="@color/text_secondary"
            android:textSize="16sp" android:lineSpacingExtra="6dp" />
    </FrameLayout>
    <Button android:id="@+id/btnAddNhanSu" style="@style/PrimaryButton" android:text="@string/add_employee"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="16dp" />
</LinearLayout>
